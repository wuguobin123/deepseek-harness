# dsh-xiaowei 邮件验证码 + SMTP 发送配置
#
# Env var names mirror the my-agents `APP_EMAIL_SMTP_*` convention so an
# operator who already has SMTP credentials for one project can copy them
# across without re-reading the docs. Both `XIAOWEI_SMTP_*` (xiaowei-native)
# and `XIAOWEI_EMAIL_SMTP_*` (my-agents alias) are read; the latter takes
# effect only when the former is unset, so this file is also compatible with
# my-agents env dumps.
#
# When `XIAOWEI_SMTP_HOST` (or its my-agents alias) is empty the seam
# falls back to the in-process `LoggingEmailSender` — codes land in the
# server's stderr, and the desktop client paints a clearly labeled
# 「开发模式」banner so the user can still finish sign-up. Set the
# variables below to a real relay and codes are delivered to the user's
# mailbox instead; the desktop banner disappears once `transportKind`
# flips to `'smtp'`.

# ── Verification-code tunables ────────────────────────────────────────────
# Master kill switch: set `XIAOWEI_EMAIL_VERIFICATION=false` to disable the
# whole seam (signup stops requiring a code; admin-only mode).
XIAOWEI_EMAIL_VERIFICATION=true
XIAOWEI_CODE_TTL_SECONDS=600
XIAOWEI_RESEND_COOLDOWN_SECONDS=60
XIAOWEI_MAX_SENDS_PER_HOUR=10
XIAOWEI_MAX_ATTEMPTS=5
XIAOWEI_LOCKOUT_SECONDS=1800

# ── Invitation-only validation cohort ────────────────────────────────────
# Existing and bootstrap accounts count toward the 100-account limit.
XIAOWEI_MAX_USERS=100
# Each account can issue three invitations for its lifetime; expired codes
# still consume one issue.
XIAOWEI_MAX_INVITATIONS_PER_USER=3
# Seven days. Each invitation can create only one account.
XIAOWEI_INVITATION_TTL_SECONDS=604800
# Optional HMAC key. Leave empty to create an owner-only sibling key file.
XIAOWEI_INVITATION_PEPPER=

# ── SMTP transport ────────────────────────────────────────────────────────
# Leave HOST empty to keep the logging transport (codes go to stderr;
# desktop client surfaces a dev banner). Fill HOST + FROM_ADDRESS to
# switch to real SMTP delivery.
XIAOWEI_SMTP_HOST=
XIAOWEI_SMTP_PORT=587
# Port 465 (163 / QQ / generic SMTPS) → set USE_SSL=true; USE_TLS is ignored.
# Port 587 (SendGrid / Gmail submission) → keep USE_SSL=false, USE_TLS=true.
XIAOWEI_SMTP_USE_SSL=false
XIAOWEI_SMTP_USE_TLS=true
XIAOWEI_SMTP_USER=
XIAOWEI_SMTP_PASSWORD=
# Must be a valid From: address accepted by your relay (often the same
# as SMTP_USER for Gmail / SendGrid; 163 / QQ typically require a
# pre-registered sender alias).
XIAOWEI_SMTP_FROM=
XIAOWEI_SMTP_TIMEOUT_SECONDS=10

# ── Account model route and billing ───────────────────────────────────────
# Admin/control-plane and model data-plane URLs are intentionally separate.
# Required 32-byte secret used to encrypt per-account model tokens at rest.
# Generate a deployment-specific value and never commit the real secret.
XIAOWEI_MASTER_KEY=
XIAOWEI_NEW_API_ADMIN_URL=
# The per-user New-API token is valid only on this gateway data plane. Do not
# point it at api.minimaxi.com unless it is an official MiniMax credential.
XIAOWEI_MODEL_BASE_URL=
XIAOWEI_NEW_API_USERNAME=
XIAOWEI_NEW_API_PASSWORD=
XIAOWEI_NEW_API_GROUP=default
XIAOWEI_NEW_API_TOKEN_QUOTA=0
XIAOWEI_NEW_API_TOKEN_UNLIMITED=true
XIAOWEI_NEW_API_TOKEN_EXPIRES_DAYS=0
XIAOWEI_MODEL_CONTEXT_WINDOW=131072
XIAOWEI_MODEL_MAX_OUTPUT_TOKENS=32768
XIAOWEI_INPUT_PRICE_MICROS_PER_TOKEN=1
XIAOWEI_OUTPUT_PRICE_MICROS_PER_TOKEN=8
XIAOWEI_MISSING_USAGE_POLICY=reserve
XIAOWEI_NEW_API_TIMEOUT_MS=10000
XIAOWEI_NEW_API_RETRIES=2
# 20 CNY expressed in the wallet's micro-CNY unit.
XIAOWEI_WELCOME_BONUS_MICROS=20000000
XIAOWEI_RESERVATION_TTL_SECONDS=3600

# ── Provider quick-reference ───────────────────────────────────────────────
# 163 邮箱 (smtp.163.com):      port=465, USE_SSL=true, USER=full@163.com
# QQ 邮箱  (smtp.qq.com):       port=465, USE_SSL=true, USER=full@qq.com
#                               (use the SMTP 授权码 from QQ Mail settings, not the login password)
# Gmail   (smtp.gmail.com):     port=587, USE_SSL=false, USE_TLS=true
#                               (App Password required when 2FA is on)
# SendGrid (smtp.sendgrid.com): port=587, USE_SSL=false, USE_TLS=true,
#                               USER=apikey, PASSWORD=<your SendGrid API key>
# Outlook  (smtp.office365.com): port=587, USE_SSL=false, USE_TLS=true
# 自建 Postfix (mail.example.com): port=25 or 587, no auth, FROM=verified sender
