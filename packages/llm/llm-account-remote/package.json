{
  "name": "@deepseek-ai/dsh-llm-account-remote",
  "description": "Device-side account model adapter over parent-process IPC",
  "version": "0.1.0-rc.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "typesVersions": { "*": { "ipc": ["lib/types/ipc.d.ts"] } },
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./ipc": { "types": "./lib/types/ipc.d.ts", "default": "./lib/ipc.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/ipc.js", "lib/types/**/*.d.ts"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-account-inference": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-account-inference": "workspace:^",
    "typescript": "^6.0.3"
  }
}
